<%- include('partials/header', { title: 'NELFUND — Upload Student List' }) %>

    <%- include('partials/navbar-staff', { staff, activePage: 'dashboard' }) %>

    <div class="container container-sm">
        <a href="/staff/dashboard" class="btn-back">&larr; Back to Dashboard</a>
        <h1 class="page-heading">Upload NELFUND Student List</h1>

        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

        <!-- Requirements -->
        <div class="requirements-box">
            <strong>&#128196; File Requirements:</strong>
            <ul>
                <li>File must be in Excel format (.xlsx or .xls)</li>
                <li>Required columns: <strong>reg_number, full_name, department, level, nelfund_amount</strong></li>
                <li>Column names must match exactly (case-insensitive)</li>
                <li>Maximum file size: <strong>10 MB</strong></li>
            </ul>
        </div>

        <div class="form-card">
            <div class="form-card-header">Select File to Upload</div>
            <div class="form-card-body">
                <form action="/staff/upload-list" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="studentList">Excel File (.xlsx / .xls) <span style="color:#c0392b">*</span></label>
                        <input type="file" name="studentList" id="studentList"
                            accept=".xlsx,.xls" required>
                        <div class="field-hint">This will merge with the existing list — previously uploaded students will be preserved.</div>
                    </div>
                    <button type="submit" class="btn-submit">&#128228; Upload File</button>
                </form>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>
