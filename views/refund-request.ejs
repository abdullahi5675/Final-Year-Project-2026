<%- include('partials/header', { title: 'NELFUND — Submit Refund Request', extraCss: `
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<style>
    /* File upload styling override */
    input[type="file"] { background: #eff6ff; border: 1.5px dashed #1e40af; }
    /* Inline error banner (JS-controlled) */
    .alert-error-dynamic { display: none; padding: 13px 16px; border-radius: 8px; margin-bottom: 18px;
        font-size: 13.5px; line-height: 1.55; background: #fdf2f3; color: #8b1a27; border: 1px solid #f5c6cb; }
</style>
` }) %>

    <%- include('partials/navbar-student', { student, activePage: '' }) %>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
        <div class="loading-text">Submitting Your Request…</div>
        <div class="loading-sub">Please wait, do not close this page.</div>
    </div>

    <div class="container container-sm">
        <h1 class="page-heading">Submit Refund Request</h1>

        <div class="alert alert-info">
            <strong>Important Notice:</strong> Once submitted, this form is locked and cannot be edited.
            Please verify all details carefully before proceeding.
        </div>

        <!-- Dynamic error shown by JS after failed AJAX submit -->
        <div class="alert-error-dynamic" id="dynamicError"></div>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/student/refund-request" enctype="multipart/form-data" id="refundForm">

            <!-- Section 1: Payment Details -->
            <div class="form-card">
                <div class="form-section-header">Section 1 — Payment Details</div>
                <div class="form-section-body">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="payment_type">Payment Type <span style="color:#c0392b">*</span></label>
                            <select name="payment_type" id="payment_type" required>
                                <option value="">— Select Payment Type —</option>
                                <option value="first_installment">First Installment</option>
                                <option value="second_installment">Second Installment</option>
                                <option value="full_payment">Full Payment</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="amount_paid">Amount Paid (₦) <span style="color:#c0392b">*</span></label>
                            <input type="number" name="amount_paid" id="amount_paid" step="0.01" required
                                placeholder="Enter the amount you paid">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="remita_number">Remita RRR Number <span style="color:#c0392b">*</span></label>
                            <input type="text" name="remita_number" id="remita_number"
                                placeholder="e.g. 191397281991"
                                maxlength="12" minlength="12"
                                inputmode="numeric"
                                pattern="[0-9]{12}"
                                autocomplete="off"
                                required>
                            <div class="field-hint">Enter your 12-digit Remita Retrieval Reference (numbers only)</div>
                            <div class="field-error" id="remita_number_error">RRR must be exactly 12 digits (numbers only).</div>
                        </div>

                        <div class="form-group">
                            <label for="remita_file">Remita Document <span style="color:#c0392b">*</span></label>
                            <div class="file-upload-wrapper">
                                <input type="file" name="remita_file" id="remita_file"
                                    accept=".pdf,.jpg,.jpeg,.png" required>
                            </div>
                            <div class="field-hint">PDF, JPG or PNG — Maximum file size: 5 MB</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Section 2: Bank Account Details -->
            <div class="form-card">
                <div class="form-section-header">Section 2 — Bank Account Details</div>
                <div class="form-section-body">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="account_name">Account Name <span style="color:#c0392b">*</span></label>
                            <input type="text" name="account_name" id="account_name" required
                                placeholder="As it appears on your bank account"
                                pattern="[A-Za-z ]+"
                                autocomplete="off">
                            <div class="field-error" id="account_name_error">Account name must contain letters and spaces only (no numbers or symbols).</div>
                        </div>

                        <div class="form-group">
                            <label for="account_number">Account Number <span style="color:#c0392b">*</span></label>
                            <input type="text" name="account_number" id="account_number" required
                                placeholder="10-digit NUBAN number"
                                maxlength="10" minlength="10"
                                inputmode="numeric"
                                pattern="[0-9]{10}"
                                autocomplete="off">
                            <div class="field-hint">Must be exactly 10 digits (numbers only)</div>
                            <div class="field-error" id="account_number_error">Account number must be exactly 10 digits (numbers only).</div>
                        </div>
                    </div>

                    <div class="form-row single">
                        <div class="form-group">
                            <label for="bank_name">Bank Name <span style="color:#c0392b">*</span></label>
                            <select name="bank_name" id="bank_name" required>
                                <option value="">— Select Your Bank —</option>
                            </select>
                        </div>
                    </div>

                </div>
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                ✅ Submit Refund Request
            </button>
        </form>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal-overlay" id="confirmModal">
        <div class="modal-card">
            <div class="modal-title">Confirm Your Details</div>
            <div id="modalDetails"></div>
            <div class="modal-actions">
                <button type="button" class="btn-edit" id="btnEdit" onclick="closeModal()">Edit Details</button>
                <button type="button" class="btn-confirm" id="btnConfirm" onclick="submitForm()">Confirm &amp; Submit</button>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // ── Load Banks (Vanilla JS, offline-safe fallback) ──────────────────
        document.addEventListener('DOMContentLoaded', function() {
            fetch('/data/banks.json')
                .then(response => response.json())
                .then(data => {
                    const bankSelect = document.getElementById('bank_name');
                    if (bankSelect) {
                        const bankNames = Object.keys(data).sort();
                        bankNames.forEach(bank => {
                            const option = document.createElement('option');
                            option.value = bank;
                            option.textContent = bank;
                            bankSelect.appendChild(option);
                        });
                        
                        // If jQuery and Select2 libraries loaded successfully, initialize Select2
                        if (typeof jQuery !== 'undefined' && typeof jQuery.fn.select2 !== 'undefined') {
                            $('#bank_name').select2({
                                placeholder: "— Select Your Bank —",
                                allowClear: true
                            });
                            $('#bank_name').trigger('change');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error loading banks:', error);
                    // Add a default error/fallback option to select manually if file is missing
                    const bankSelect = document.getElementById('bank_name');
                    if (bankSelect) {
                        const option = document.createElement('option');
                        option.value = "";
                        option.textContent = "⚠️ Error loading bank list. Please refresh or contact admin.";
                        bankSelect.appendChild(option);
                    }
                });
        });

        // ── Form Submission and Modal Logic ────────────────────────────────
        const form           = document.getElementById('refundForm');
        const modal          = document.getElementById('confirmModal');
        const modalDetails   = document.getElementById('modalDetails');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const dynamicError   = document.getElementById('dynamicError');

        function showError(msg) {
            dynamicError.textContent = msg;
            dynamicError.style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function hideError() {
            dynamicError.style.display = 'none';
            dynamicError.textContent = '';
        }

        function setFieldError(inputEl, errorEl, hasError) {
            if (hasError) {
                inputEl.classList.add('input-invalid');
                inputEl.classList.remove('input-valid');
                errorEl.style.display = 'block';
            } else {
                inputEl.classList.remove('input-invalid');
                inputEl.classList.add('input-valid');
                errorEl.style.display = 'none';
            }
        }

        // ── Real-time: RRR — numbers only ─────────────────────────────────
        const remitaInput = document.getElementById('remita_number');
        const remitaError = document.getElementById('remita_number_error');

        remitaInput.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 0) {
                setFieldError(this, remitaError, this.value.length !== 12);
            } else {
                this.classList.remove('input-invalid', 'input-valid');
                remitaError.style.display = 'none';
            }
        });
        remitaInput.addEventListener('keypress', function (e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
        remitaInput.addEventListener('paste', function (e) {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text');
            this.value = pasted.replace(/[^0-9]/g, '').slice(0, 12);
            this.dispatchEvent(new Event('input'));
        });

        // ── Real-time: Account Number ──────────────────────────────────────
        const acctNumInput = document.getElementById('account_number');
        const acctNumError = document.getElementById('account_number_error');

        acctNumInput.addEventListener('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '');
            if (this.value.length > 0) {
                setFieldError(this, acctNumError, this.value.length !== 10);
            } else {
                this.classList.remove('input-invalid', 'input-valid');
                acctNumError.style.display = 'none';
            }
        });
        acctNumInput.addEventListener('keypress', function (e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
        acctNumInput.addEventListener('paste', function (e) {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text');
            this.value = pasted.replace(/[^0-9]/g, '').slice(0, 10);
            this.dispatchEvent(new Event('input'));
        });

        // ── Real-time: Account Name ────────────────────────────────────────
        const acctNameInput = document.getElementById('account_name');
        const acctNameError = document.getElementById('account_name_error');

        acctNameInput.addEventListener('input', function () {
            this.value = this.value.replace(/[^A-Za-z ]/g, '');
            if (this.value.trim().length > 0) {
                setFieldError(this, acctNameError, false);
            } else if (this.value.length > 0) {
                setFieldError(this, acctNameError, true);
            } else {
                this.classList.remove('input-invalid', 'input-valid');
                acctNameError.style.display = 'none';
            }
        });
        acctNameInput.addEventListener('keypress', function (e) { if (!/[A-Za-z ]/.test(e.key)) e.preventDefault(); });
        acctNameInput.addEventListener('paste', function (e) {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData('text');
            this.value = pasted.replace(/[^A-Za-z ]/g, '');
            this.dispatchEvent(new Event('input'));
        });

        // ── Form submit with full validation ──────────────────────────────
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            hideError();

            let hasErrors = false;

            const file = document.getElementById('remita_file').files[0];
            if (!file) { showError('Please upload your Remita document.'); return; }
            if (file.size > 5242880) { showError('File size exceeds 5 MB. Please upload a smaller file.'); return; }

            const rrr = remitaInput.value.trim();
            if (!/^[0-9]{12}$/.test(rrr)) { setFieldError(remitaInput, remitaError, true); hasErrors = true; }

            const acct = acctNumInput.value.trim();
            if (!/^[0-9]{10}$/.test(acct)) { setFieldError(acctNumInput, acctNumError, true); hasErrors = true; }

            const acctName = acctNameInput.value.trim();
            if (!/^[A-Za-z ]+$/.test(acctName)) { setFieldError(acctNameInput, acctNameError, true); hasErrors = true; }

            if (hasErrors) { showError('Please fix the highlighted fields before submitting.'); return; }

            // Populate and show confirmation modal
            const paymentType     = document.getElementById('payment_type').options[document.getElementById('payment_type').selectedIndex].text;
            const amount          = document.getElementById('amount_paid').value;
            const bankName        = document.getElementById('bank_name').value;
            const formattedAmount = new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(amount);

            modalDetails.innerHTML = `
                <div class="modal-detail"><strong>Payment Type:</strong> <span>${paymentType}</span></div>
                <div class="modal-detail"><strong>Amount Paid:</strong> <span>${formattedAmount}</span></div>
                <div class="modal-detail"><strong>Remita RRR:</strong> <span>${rrr}</span></div>
                <hr style="margin:12px 0;border:0;border-top:1px solid #eee;">
                <div class="modal-detail"><strong>Account Name:</strong> <span>${acctName}</span></div>
                <div class="modal-detail"><strong>Account No:</strong> <span>${acct}</span></div>
                <div class="modal-detail"><strong>Bank Name:</strong> <span>${bankName}</span></div>
            `;
            modal.classList.add('active');
        });

        function closeModal() { modal.classList.remove('active'); }

        async function submitForm() {
            modal.classList.remove('active');
            loadingOverlay.classList.add('active');
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('btnConfirm').disabled = true;

            try {
                const formData = new FormData(form);
                const response = await fetch('/student/refund-request', { method: 'POST', body: formData });
                const result   = await response.json();

                if (result.success) {
                    window.location.href = result.redirect || '/student/dashboard';
                } else {
                    loadingOverlay.classList.remove('active');
                    document.getElementById('submitBtn').disabled = false;
                    document.getElementById('btnConfirm').disabled = false;
                    showError(result.error || 'Submission failed. Please try again.');
                }
            } catch (networkErr) {
                loadingOverlay.classList.remove('active');
                document.getElementById('submitBtn').disabled = false;
                document.getElementById('btnConfirm').disabled = false;
                showError('Network error. Please check your connection and try again.');
            }
        }
    </script>

<%- include('partials/footer') %>
