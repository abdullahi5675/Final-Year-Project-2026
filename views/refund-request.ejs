<%- include('partials/header', { title: 'NELFUND — Submit Refund Request', extraCss: `
<style>
    input[type="file"] { background: #eff6ff; border: 1.5px dashed #1e40af; }
    .alert-error-dynamic {
        display: none; padding: 13px 16px; border-radius: 8px; margin-bottom: 18px;
        font-size: 13.5px; line-height: 1.55; background: #fdf2f3;
        color: #8b1a27; border: 1px solid #f5c6cb;
    }

    /* ── Searchable Bank Field ── */
    .bank-select-container { position: relative; width: 100%; }

    .bank-input-wrap {
        position: relative; display: flex; align-items: center; width: 100%;
    }

    .bank-search-input {
        width: 100%; padding: 11px 40px 11px 14px; font-size: 14px; font-family: inherit;
        border: 1.5px solid #d1d5db; border-radius: 8px; background: #ffffff;
        color: #111827; outline: none; transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box; min-height: 44px;
    }
    .bank-search-input:focus { border-color: #152c5b; box-shadow: 0 0 0 3px rgba(21,44,91,0.1); }
    .bank-search-input.invalid { border-color: #e53e3e !important; background: #fff5f5; }
    .bank-search-input.valid   { border-color: #38a169; }

    .bank-dropdown-arrow {
        position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
        font-size: 11px; color: #9ca3af; pointer-events: none; transition: transform .2s;
    }
    .bank-select-container.open .bank-dropdown-arrow { transform: translateY(-50%) rotate(180deg); color: #152c5b; }

    .bank-clear-btn {
        display: none; position: absolute; right: 34px; top: 50%; transform: translateY(-50%);
        background: #e2e8f0; border: none; border-radius: 50%; width: 20px; height: 20px;
        font-size: 12px; line-height: 20px; text-align: center; color: #64748b; cursor: pointer;
        transition: background .15s, color .15s; padding: 0;
    }
    .bank-clear-btn:hover { background: #cbd5e1; color: #1e293b; }
    .bank-clear-btn.visible { display: block; }

    .bank-dropdown-panel {
        display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0;
        z-index: 9999; background: #ffffff; border: 1.5px solid #94a3b8;
        border-radius: 10px; box-shadow: 0 12px 36px rgba(0,0,0,0.18);
        max-height: 380px; overflow-y: scroll;
        scrollbar-width: thin;
        scrollbar-color: #64748b #f1f5f9;
    }
    .bank-dropdown-panel::-webkit-scrollbar {
        width: 10px;
    }
    .bank-dropdown-panel::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 0 8px 8px 0;
    }
    .bank-dropdown-panel::-webkit-scrollbar-thumb {
        background: #64748b;
        border-radius: 5px;
        border: 2px solid #f1f5f9;
    }
    .bank-dropdown-panel::-webkit-scrollbar-thumb:hover {
        background: #152c5b;
    }
    .bank-select-container.open .bank-dropdown-panel { display: block; }

    /* Support upward dropdown when near bottom of viewport */
    .bank-select-container.drop-up .bank-dropdown-panel {
        top: auto; bottom: calc(100% + 6px);
        box-shadow: 0 -12px 36px rgba(0,0,0,0.18);
    }

    .bank-card-expanded {
        padding-bottom: 220px !important;
        transition: padding-bottom .25s ease;
    }

    .bank-option-item {
        padding: 11px 16px; font-size: 14px; color: #1e293b; cursor: pointer;
        border-bottom: 1px solid #f1f5f9; transition: background .12s, color .12s;
    }
    .bank-option-item:last-child { border-bottom: none; }
    .bank-option-item:hover, .bank-option-item.kb-active { background: #eff6ff; color: #152c5b; font-weight: 600; }
    .bank-option-item.selected { background: #152c5b; color: #ffffff; font-weight: 600; }

    .bank-no-match {
        padding: 20px; text-align: center; color: #94a3b8; font-size: 13.5px;
    }
</style>
` }) %>

<%- include('partials/navbar-student', { student, activePage: '' }) %>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner"></div>
    <div class="loading-text">Submitting Your Request…</div>
    <div class="loading-sub">Please wait, do not close this page.</div>
</div>

<div class="container container-sm">
    <h1 class="page-heading">Submit Refund Request</h1>

    <div class="alert alert-info">
        <strong>Important Notice:</strong> Once submitted, this form is locked and cannot be edited.
        Please verify all details carefully before proceeding.
    </div>

    <div class="alert-error-dynamic" id="dynamicError"></div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/student/refund-request" enctype="multipart/form-data" id="refundForm">

        <!-- Section 1: Payment Details -->
        <div class="form-card">
            <div class="form-section-header">Section 1 — Payment Details</div>
            <div class="form-section-body">

                <div class="form-row">
                    <div class="form-group">
                        <label for="payment_type">Payment Type <span style="color:#c0392b">*</span></label>
                        <select name="payment_type" id="payment_type" required>
                            <option value="">— Select Payment Type —</option>
                            <option value="first_installment">First Installment</option>
                            <option value="second_installment">Second Installment</option>
                            <option value="full_payment">Full Payment</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="amount_paid">Amount Paid (₦) <span style="color:#c0392b">*</span></label>
                        <input type="number" name="amount_paid" id="amount_paid" step="0.01" required
                            placeholder="Enter the amount you paid">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="remita_number">Remita RRR Number <span style="color:#c0392b">*</span></label>
                        <input type="text" name="remita_number" id="remita_number"
                            placeholder="e.g. 191397281991"
                            maxlength="12" minlength="12"
                            inputmode="numeric" pattern="[0-9]{12}"
                            autocomplete="off" required>
                        <div class="field-hint">Enter your 12-digit Remita Retrieval Reference (numbers only)</div>
                        <div class="field-error" id="remita_number_error">RRR must be exactly 12 digits (numbers only).</div>
                    </div>

                    <div class="form-group">
                        <label for="remita_file">Remita Document <span style="color:#c0392b">*</span></label>
                        <div class="file-upload-wrapper">
                            <input type="file" name="remita_file" id="remita_file"
                                accept=".pdf,.jpg,.jpeg,.png" required>
                        </div>
                        <div class="field-hint">PDF, JPG or PNG — Maximum file size: 5 MB</div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Section 2: Bank Account Details -->
        <div class="form-card" id="bankDetailsCard">
            <div class="form-section-header">Section 2 — Bank Account Details</div>
            <div class="form-section-body">

                <div class="form-row">
                    <div class="form-group">
                        <label for="account_name">Account Name <span style="color:#c0392b">*</span></label>
                        <input type="text" name="account_name" id="account_name" required
                            placeholder="As it appears on your bank account"
                            pattern="[A-Za-z ]+" autocomplete="off">
                        <div class="field-error" id="account_name_error">Account name must contain letters and spaces only.</div>
                    </div>

                    <div class="form-group">
                        <label for="account_number">Account Number <span style="color:#c0392b">*</span></label>
                        <input type="text" name="account_number" id="account_number" required
                            placeholder="10-digit NUBAN number"
                            maxlength="10" minlength="10"
                            inputmode="numeric" pattern="[0-9]{10}" autocomplete="off">
                        <div class="field-hint">Must be exactly 10 digits (numbers only)</div>
                        <div class="field-error" id="account_number_error">Account number must be exactly 10 digits.</div>
                    </div>
                </div>

                <!-- Searchable Bank Select Field -->
                <div class="form-row single">
                    <div class="form-group">
                        <label for="bank_search_input">Bank Name <span style="color:#c0392b">*</span></label>

                        <!-- Hidden input submitted with the form -->
                        <input type="hidden" name="bank_name" id="bank_name_hidden">

                        <div class="bank-select-container" id="bankSelectContainer">
                            <div class="bank-input-wrap">
                                <input type="text"
                                       id="bank_search_input"
                                       class="bank-search-input"
                                       placeholder="Search and select your bank (e.g. Access Bank, GTBank, Kuda)..."
                                       autocomplete="off" spellcheck="false">
                                <span class="bank-dropdown-arrow">&#9660;</span>
                                <button type="button" class="bank-clear-btn" id="bankClearBtn" title="Clear selection">&times;</button>
                            </div>

                            <div class="bank-dropdown-panel" id="bankDropdownPanel">
                                <div class="bank-options-list" id="bankOptionsList"></div>
                            </div>
                        </div>

                        <div class="field-hint">Click or type to filter and select your bank</div>
                        <div class="field-error" id="bank_name_error">Please select your bank from the list.</div>
                    </div>
                </div>

            </div>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
            ✅ Submit Refund Request
        </button>
    </form>
</div>

<!-- Confirmation Modal -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-card">
        <div class="modal-title">Confirm Your Details</div>
        <div id="modalDetails"></div>
        <div class="modal-actions">
            <button type="button" class="btn-edit" id="btnEdit" onclick="closeConfirmModal()">Edit Details</button>
            <button type="button" class="btn-confirm" id="btnConfirm" onclick="doSubmitForm()">Confirm &amp; Submit</button>
        </div>
    </div>
</div>

<script>
/* ================================================================
   SEARCHABLE BANK COMBOBOX  —  100% Vanilla JS, Zero CDN/jQuery
   ================================================================ */
(function () {
    var DEFAULT_BANKS = [
        "ACCESS BANK", "ACCESSMONEY", "ACCION MFB", "ALERT MFB", "ALHAYAT MFB", "AMJU MFB",
        "ASOSAVINGS", "ATBU Microfinance Bank", "BAYERO MICROFINANCE BANK", "BOCTRUST MICROFINANCE BANK",
        "CARBON", "CELLULANT", "CITI BANK", "CORONATION", "COVENANT MFB", "CROWDFORCE",
        "ECOBANK NIGERIA", "EDFIN MFB", "EKONDO MICROFINANCE BANK", "EYOWO", "FBNQUEST MERCHANT BANK",
        "FCMB", "FIDELITY BANK", "FIRST BANK OF NIGERIA", "FIRST CITY MONUMENT BANK", "FLUTTERWAVE",
        "GLOBUS BANK", "GTBANK", "HASAL MICROFINANCE BANK", "HERITAGE BANK", "JAIZ BANK",
        "KUDA BANK", "LOTUS BANK", "MONIEPOINT MICROFINANCE BANK", "MUTUAL TRUST MICROFINANCE BANK",
        "NPF MICROFINANCE BANK", "ONE FINANCE", "OPAY", "OPTIMUS BANK", "PALMPAY",
        "PARALLEX BANK", "POLARIS BANK", "PREMIUM TRUST BANK", "PROVIDUS BANK", "RUBIES MFB",
        "SAFE HAVEN MFB", "SIGNATURE BANK", "STANBIC IBTC BANK", "STANDARD CHARTERED BANK",
        "STERLING BANK", "SUNTRUST BANK", "TAJ BANK", "TITAN TRUST BANK", "UNION BANK OF NIGERIA",
        "UNITED BANK FOR AFRICA", "UNITY BANK", "VFD MICROFINANCE BANK", "WEMA BANK", "ZENITH BANK"
    ];

    var bankList = DEFAULT_BANKS;
    var container = document.getElementById('bankSelectContainer');
    var input = document.getElementById('bank_search_input');
    var hidden = document.getElementById('bank_name_hidden');
    var dropdown = document.getElementById('bankDropdownPanel');
    var listEl = document.getElementById('bankOptionsList');
    var clearBtn = document.getElementById('bankClearBtn');
    var errEl = document.getElementById('bank_name_error');
    var kbIndex = -1;

    // Load full list asynchronously from /data/banks.json if accessible
    fetch('/data/banks.json')
        .then(function (r) { return r.json(); })
        .then(function (data) {
            var names = Object.keys(data).sort();
            if (names.length > 0) {
                bankList = names;
                if (container && container.classList.contains('open')) {
                    renderList(filterBanks(input.value));
                }
            }
        })
        .catch(function () {});

    function filterBanks(query) {
        var q = (query || '').trim().toLowerCase();
        if (!q) return bankList;
        return bankList.filter(function (b) {
            return b.toLowerCase().indexOf(q) !== -1;
        });
    }

    function renderList(items) {
        listEl.innerHTML = '';
        kbIndex = -1;

        if (items.length === 0) {
            listEl.innerHTML = '<div class="bank-no-match">No banks match your search.</div>';
            return;
        }

        var html = '';
        for (var i = 0; i < items.length; i++) {
            var b = items[i];
            var isSel = hidden.value === b;
            var cls = 'bank-option-item' + (isSel ? ' selected' : '');
            html += '<div class="' + cls + '" data-bank="' + escapeHtml(b) + '">' + escapeHtml(b) + '</div>';
        }
        listEl.innerHTML = html;
    }

    var bankCard = document.getElementById('bankDetailsCard');

    function openDropdown() {
        var rect = input.getBoundingClientRect();
        var spaceBelow = window.innerHeight - rect.bottom;
        var spaceAbove = rect.top;

        // If less than 380px below and more space above, flip dropdown UPWARDS
        if (spaceBelow < 380 && spaceAbove > spaceBelow) {
            container.classList.add('drop-up');
            if (bankCard) bankCard.classList.remove('bank-card-expanded');
        } else {
            container.classList.remove('drop-up');
            if (bankCard) bankCard.classList.add('bank-card-expanded');
        }

        container.classList.add('open');
        renderList(filterBanks(input.value));
    }

    function closeDropdown() {
        container.classList.remove('open', 'drop-up');
        if (bankCard) bankCard.classList.remove('bank-card-expanded');
        kbIndex = -1;
    }

    function selectBank(name) {
        input.value = name;
        hidden.value = name;
        input.classList.add('valid');
        input.classList.remove('invalid');
        errEl.style.display = 'none';
        clearBtn.classList.add('visible');
        closeDropdown();
    }

    function clearSelection() {
        input.value = '';
        hidden.value = '';
        input.classList.remove('valid', 'invalid');
        clearBtn.classList.remove('visible');
        errEl.style.display = 'none';
        if (container.classList.contains('open')) renderList(bankList);
    }

    function escapeHtml(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Input events
    input.addEventListener('focus', openDropdown);
    input.addEventListener('click', openDropdown);

    input.addEventListener('input', function () {
        var q = this.value;
        if (!q) {
            hidden.value = '';
            clearBtn.classList.remove('visible');
            input.classList.remove('valid', 'invalid');
        } else {
            clearBtn.classList.add('visible');
            var exact = bankList.find(function (b) { return b.toLowerCase() === q.trim().toLowerCase(); });
            if (exact) {
                hidden.value = exact;
                input.classList.add('valid');
                input.classList.remove('invalid');
                errEl.style.display = 'none';
            } else {
                hidden.value = '';
            }
        }
        openDropdown();
    });

    clearBtn.addEventListener('mousedown', function (e) {
        e.preventDefault();
        clearSelection();
        input.focus();
    });

    listEl.addEventListener('mousedown', function (e) {
        var item = e.target.closest('.bank-option-item');
        if (item) {
            e.preventDefault();
            var name = item.getAttribute('data-bank');
            if (name) selectBank(name);
        }
    });

    // Keyboard navigation
    input.addEventListener('keydown', function (e) {
        var items = listEl.querySelectorAll('.bank-option-item');
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (!container.classList.contains('open')) openDropdown();
            kbIndex = Math.min(kbIndex + 1, items.length - 1);
            updateKbActive(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            kbIndex = Math.max(kbIndex - 1, 0);
            updateKbActive(items);
        } else if (e.key === 'Enter') {
            if (container.classList.contains('open') && kbIndex >= 0 && items[kbIndex]) {
                e.preventDefault();
                var name = items[kbIndex].getAttribute('data-bank');
                if (name) selectBank(name);
            }
        } else if (e.key === 'Escape') {
            closeDropdown();
        }
    });

    function updateKbActive(items) {
        for (var i = 0; i < items.length; i++) {
            if (i === kbIndex) {
                items[i].classList.add('kb-active');
                items[i].scrollIntoView({ block: 'nearest' });
            } else {
                items[i].classList.remove('kb-active');
            }
        }
    }

    document.addEventListener('mousedown', function (e) {
        if (!container.contains(e.target)) {
            closeDropdown();
        }
    });

    window._validateBank = function () {
        if (input.value && !hidden.value) {
            var match = bankList.find(function (b) { return b.toLowerCase() === input.value.trim().toLowerCase(); });
            if (match) selectBank(match);
        }
        if (!hidden.value) {
            input.classList.add('invalid');
            errEl.style.display = 'block';
            return false;
        }
        return true;
    };
})();

/* ================================================================
   FORM VALIDATION & SUBMISSION
   ================================================================ */
var form           = document.getElementById('refundForm');
var modal          = document.getElementById('confirmModal');
var modalDetails   = document.getElementById('modalDetails');
var loadingOverlay = document.getElementById('loadingOverlay');
var dynamicError   = document.getElementById('dynamicError');

function showError(msg) {
    dynamicError.textContent = msg;
    dynamicError.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
}
function hideError() {
    dynamicError.style.display = 'none';
    dynamicError.textContent = '';
}
function setFieldErr(inp, errEl, bad) {
    if (bad) {
        inp.classList.add('input-invalid');
        inp.classList.remove('input-valid');
        errEl.style.display = 'block';
    } else {
        inp.classList.remove('input-invalid');
        inp.classList.add('input-valid');
        errEl.style.display = 'none';
    }
}

/* ── Real-time: RRR ── */
var remitaInp = document.getElementById('remita_number');
var remitaErr = document.getElementById('remita_number_error');
remitaInp.addEventListener('input', function () {
    this.value = this.value.replace(/[^0-9]/g, '');
    if (this.value.length > 0) setFieldErr(this, remitaErr, this.value.length !== 12);
    else { this.classList.remove('input-invalid','input-valid'); remitaErr.style.display='none'; }
});
remitaInp.addEventListener('keypress', function (e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
remitaInp.addEventListener('paste', function (e) {
    e.preventDefault();
    this.value = (e.clipboardData||window.clipboardData).getData('text').replace(/[^0-9]/g,'').slice(0,12);
    this.dispatchEvent(new Event('input'));
});

/* ── Real-time: Account Number ── */
var acctNumInp = document.getElementById('account_number');
var acctNumErr = document.getElementById('account_number_error');
acctNumInp.addEventListener('input', function () {
    this.value = this.value.replace(/[^0-9]/g, '');
    if (this.value.length > 0) setFieldErr(this, acctNumErr, this.value.length !== 10);
    else { this.classList.remove('input-invalid','input-valid'); acctNumErr.style.display='none'; }
});
acctNumInp.addEventListener('keypress', function (e) { if (!/[0-9]/.test(e.key)) e.preventDefault(); });
acctNumInp.addEventListener('paste', function (e) {
    e.preventDefault();
    this.value = (e.clipboardData||window.clipboardData).getData('text').replace(/[^0-9]/g,'').slice(0,10);
    this.dispatchEvent(new Event('input'));
});

/* ── Real-time: Account Name ── */
var acctNameInp = document.getElementById('account_name');
var acctNameErr = document.getElementById('account_name_error');
acctNameInp.addEventListener('input', function () {
    this.value = this.value.replace(/[^A-Za-z ]/g, '');
    if (this.value.trim().length > 0) setFieldErr(this, acctNameErr, false);
    else if (this.value.length > 0) setFieldErr(this, acctNameErr, true);
    else { this.classList.remove('input-invalid','input-valid'); acctNameErr.style.display='none'; }
});
acctNameInp.addEventListener('keypress', function (e) { if (!/[A-Za-z ]/.test(e.key)) e.preventDefault(); });
acctNameInp.addEventListener('paste', function (e) {
    e.preventDefault();
    this.value = (e.clipboardData||window.clipboardData).getData('text').replace(/[^A-Za-z ]/g,'');
    this.dispatchEvent(new Event('input'));
});

/* ── Form Submit ── */
form.addEventListener('submit', function (e) {
    e.preventDefault();
    hideError();

    var hasErr = false;

    var file = document.getElementById('remita_file').files[0];
    if (!file)              { showError('Please upload your Remita document.'); return; }
    if (file.size > 5242880){ showError('File size exceeds 5 MB. Please upload a smaller file.'); return; }

    var rrr = remitaInp.value.trim();
    if (!/^[0-9]{12}$/.test(rrr)) { setFieldErr(remitaInp, remitaErr, true); hasErr = true; }

    var acct = acctNumInp.value.trim();
    if (!/^[0-9]{10}$/.test(acct)) { setFieldErr(acctNumInp, acctNumErr, true); hasErr = true; }

    var acctName = acctNameInp.value.trim();
    if (!/^[A-Za-z ]+$/.test(acctName)) { setFieldErr(acctNameInp, acctNameErr, true); hasErr = true; }

    if (!window._validateBank()) hasErr = true;

    if (hasErr) { showError('Please fix the highlighted fields before submitting.'); return; }

    /* Build confirmation modal content */
    var ptSel    = document.getElementById('payment_type');
    var ptLabel  = ptSel.options[ptSel.selectedIndex].text;
    var amount   = document.getElementById('amount_paid').value;
    var bankName = document.getElementById('bank_name_hidden').value;
    var fmtAmt   = new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN' }).format(amount);

    modalDetails.innerHTML =
        '<div class="modal-detail"><strong>Payment Type:</strong> <span>' + ptLabel + '</span></div>' +
        '<div class="modal-detail"><strong>Amount Paid:</strong> <span>' + fmtAmt + '</span></div>' +
        '<div class="modal-detail"><strong>Remita RRR:</strong> <span>' + rrr + '</span></div>' +
        '<hr style="margin:12px 0;border:0;border-top:1px solid #eee;">' +
        '<div class="modal-detail"><strong>Account Name:</strong> <span>' + acctName + '</span></div>' +
        '<div class="modal-detail"><strong>Account No:</strong> <span>' + acct + '</span></div>' +
        '<div class="modal-detail"><strong>Bank Name:</strong> <span>' + bankName + '</span></div>';

    modal.classList.add('active');
});

function closeConfirmModal() { modal.classList.remove('active'); }

async function doSubmitForm() {
    modal.classList.remove('active');
    loadingOverlay.classList.add('active');
    document.getElementById('submitBtn').disabled   = true;
    document.getElementById('btnConfirm').disabled  = true;

    try {
        var formData = new FormData(form);
        var response = await fetch('/student/refund-request', { method: 'POST', body: formData });
        var result   = await response.json();

        if (result.success) {
            window.location.href = result.redirect || '/student/dashboard';
        } else {
            loadingOverlay.classList.remove('active');
            document.getElementById('submitBtn').disabled  = false;
            document.getElementById('btnConfirm').disabled = false;
            showError(result.error || 'Submission failed. Please try again.');
        }
    } catch (netErr) {
        loadingOverlay.classList.remove('active');
        document.getElementById('submitBtn').disabled  = false;
        document.getElementById('btnConfirm').disabled = false;
        showError('Network error. Please check your connection and try again.');
    }
}
</script>

<%- include('partials/footer') %>
