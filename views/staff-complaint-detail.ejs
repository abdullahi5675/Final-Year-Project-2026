<%- include('partials/header', { title: 'NELFUND — Complaint Detail' }) %>

    <%- include('partials/navbar-staff', { staff, activePage: 'complaints' }) %>

    <div class="container container-sm">
        <a href="/staff/complaints" class="btn-back">&larr; Back to Complaints</a>
        <h1 class="page-heading">Reply to Complaint</h1>



        <!-- Complaint Details -->
        <div class="card-padded" style="margin-bottom:22px;">
            <div class="card-header" style="margin: -24px -24px 20px; border-radius:10px 10px 0 0;">Complaint Details</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Student</div>
                    <div class="info-value"><%= complaint.full_name %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Reg. Number</div>
                    <div class="info-value"><%= complaint.reg_number %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Date Submitted</div>
                    <div class="info-value"><%= new Date(complaint.created_at).toLocaleString() %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Status</div>
                    <div class="info-value" style="margin-top:4px;">
                        <span class="badge badge-<%= complaint.status %>">
                            <%= complaint.status.toUpperCase() %>
                        </span>
                    </div>
                </div>
            </div>

            <hr class="divider">

            <div style="margin-bottom:12px;">
                <div class="info-label">Subject</div>
                <div class="info-value" style="font-size:16px; font-weight:700; color:#152c5b; margin-top:4px;">
                    <%= complaint.subject %>
                </div>
            </div>

            <div>
                <div class="info-label">Message</div>
                <div style="font-size:14px; color:#333; line-height:1.7; margin-top:6px; background:#f8fafc; border-radius:8px; padding:14px 16px; border:1px solid #e2e8f0;">
                    <%= complaint.message %>
                </div>
            </div>

            <% if (complaint.status === 'answered') { %>
                <hr class="divider">
                <div class="reply-box">
                    <div class="reply-label">Your Reply</div>
                    <%= complaint.reply %>
                    <div class="reply-date">
                        Replied: <%= new Date(complaint.replied_at).toLocaleString() %>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Reply Form (only if pending) -->
        <% if (complaint.status !== 'answered') { %>
        <div class="card-padded">
            <div class="card-header" style="margin: -24px -24px 20px; border-radius:10px 10px 0 0;">Write Reply</div>
            <form action="/staff/complaints/<%= complaint.complaint_id %>/reply" method="POST">
                <div class="form-group">
                    <label for="reply">Your Response <span style="color:#c0392b">*</span></label>
                    <textarea id="reply" name="reply" required rows="5"
                        placeholder="Type your reply here..."></textarea>
                </div>
                <button type="submit" class="btn-submit">&#10003; Send Reply</button>
            </form>
        </div>
        <% } %>
    </div>

<%- include('partials/footer') %>