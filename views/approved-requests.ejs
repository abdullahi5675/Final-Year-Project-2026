<%- include('partials/header', { title: 'FUTB NELFUND — Approved Refund Directory' }) %>

<div class="app-wrapper" id="appWrapper">
    <%- include('partials/sidebar-staff', { staff, activePage: 'approved' }) %>

    <main class="app-main">
        <%- include('partials/topbar-staff', { staff, pageTitle: 'Approved Refund Directory' }) %>

        <div class="app-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1 class="page-heading" style="margin-bottom: 4px; border: none; padding: 0;">Approved Refund Requests</h1>
                    <p style="color: #64748b; font-size: 14px;">Complete directory of all approved student refund applications, Bursary export statuses, and batch schedules.</p>
                </div>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <a href="/staff/generate-batch" class="btn" style="background: #059669; color: white; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                        Export New Bursary Schedule
                    </a>
                    <a href="/staff/approved-requests/export?search=<%= encodeURIComponent(search) %>&filter=<%= encodeURIComponent(filter) %>" class="btn" style="background: #152c5b; color: white; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                        Export Filtered Excel
                    </a>
                </div>
            </div>

            <% if (notice === 'no_unbatched') { %>
                <div class="alert alert-info" style="background:#eff6ff; color:#1e40af; padding:14px 18px; border-radius:10px; margin-bottom:24px; border:1px solid #bfdbfe; font-size:14px; display:flex; align-items:center; gap:10px;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
                    <div>
                        <strong>Bursary Schedule Notice:</strong> There are currently no new unbatched approved requests available to generate a new export file. All approved requests have either been exported into previous batch schedules or are awaiting pending verification.
                    </div>
                </div>
            <% } %>

            <!-- Search and Filter Control Bar -->
            <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; padding: 20px; margin-bottom: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                <form method="GET" action="/staff/approved-requests" style="display: flex; gap: 16px; flex-wrap: wrap; align-items: center;">
                    <div style="flex: 1; min-width: 240px;">
                        <input type="text" name="search" value="<%= search %>" placeholder="Search by Registration Number or Student Name..." style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 14px;">
                    </div>

                    <div style="min-width: 200px;">
                        <select name="filter" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 14px; background: white;">
                            <option value="all" <% if (filter === 'all') { %>selected<% } %>>All Approved Requests</option>
                            <option value="ready" <% if (filter === 'ready') { %>selected<% } %>>Ready for Bursary Export (Unbatched)</option>
                            <option value="exported" <% if (filter === 'exported') { %>selected<% } %>>Exported to Bursary (Batched)</option>
                            <% batches.forEach(function(b) { %>
                                <option value="<%= b.batch_id %>" <% if (filter == b.batch_id) { %>selected<% } %>>
                                    Batch: <%= b.batch_number %> (<%= b.student_count %> students)
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <button type="submit" class="btn" style="background: #152c5b; color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 600; border: none; cursor: pointer;">
                        Apply Filter
                    </button>

                    <% if (search || filter !== 'all') { %>
                        <a href="/staff/approved-requests" class="btn" style="background: #f1f5f9; color: #475569; padding: 10px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none;">
                            Reset Filters
                        </a>
                    <% } %>
                </form>
            </div>

            <!-- Approved Requests Table -->
            <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                <% if (requests.length === 0) { %>
                    <div style="text-align: center; padding: 60px 40px; color: #64748b;">
                        <div style="display:inline-flex; width:56px; height:56px; background:#eff6ff; border-radius:50%; align-items:center; justify-content:center; margin-bottom:16px; color:#2563eb;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                        </div>
                        <h3 style="font-size: 18px; color: #0f172a; margin-bottom: 8px; font-weight: 700;">No Approved Requests Found</h3>
                        <p style="font-size: 14px; margin: 0;">No matching approved refund requests were found for the selected search or filter criteria.</p>
                    </div>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                            <thead>
                                <tr style="background: #152c5b; color: white;">
                                    <th style="padding: 14px 16px;">S/N</th>
                                    <th style="padding: 14px 16px;">Reg Number</th>
                                    <th style="padding: 14px 16px;">Full Name</th>
                                    <th style="padding: 14px 16px;">Department / Level</th>
                                    <th style="padding: 14px 16px;">Bank Account</th>
                                    <th style="padding: 14px 16px;">Amount (₦)</th>
                                    <th style="padding: 14px 16px;">Bursary Export Status</th>
                                    <th style="padding: 14px 16px;">Date Approved</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% requests.forEach(function(r, index) { %>
                                    <tr style="border-bottom: 1px solid #e2e8f0; background: <%= index % 2 === 0 ? '#ffffff' : '#f8fafc' %>;">
                                        <td style="padding: 14px 16px;"><%= index + 1 %></td>
                                        <td style="padding: 14px 16px; font-weight: 600; color: #0f172a; font-family: monospace;"><%= r.reg_number %></td>
                                        <td style="padding: 14px 16px; font-weight: 600; color: #0f172a;"><%= r.full_name %></td>
                                        <td style="padding: 14px 16px;">
                                            <div style="font-weight: 500; color: #334155;"><%= r.department %></div>
                                            <div style="font-size: 12px; color: #64748b;">Level <%= r.level %></div>
                                        </td>
                                        <td style="padding: 14px 16px;">
                                            <div style="font-weight: 600; color: #0f172a;"><%= r.account_name || 'N/A' %></div>
                                            <div style="font-size: 12px; color: #64748b; font-family: monospace;"><%= r.account_number %> &bull; <%= r.bank_name %></div>
                                        </td>
                                        <td style="padding: 14px 16px; font-weight: 700; color: #059669;">
                                            ₦<%= parseFloat(r.refund_amount || 0).toLocaleString('en-NG', {minimumFractionDigits:2}) %>
                                        </td>
                                        <td style="padding: 14px 16px;">
                                            <% if (r.batch_number) { %>
                                                <span style="display:inline-block; padding: 4px 10px; border-radius: 12px; font-size: 11.5px; font-weight: 700; background: #dbeafe; color: #1e40af;">
                                                    Exported: <%= r.batch_number %>
                                                </span>
                                            <% } else { %>
                                                <span style="display:inline-block; padding: 4px 10px; border-radius: 12px; font-size: 11.5px; font-weight: 700; background: #dcfce7; color: #166534;">
                                                    Ready for Export
                                                </span>
                                            <% } %>
                                        </td>
                                        <td style="padding: 14px 16px; color: #64748b; font-size: 12.5px; white-space: nowrap;">
                                            <%= r.verified_at ? new Date(r.verified_at).toLocaleDateString('en-NG', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A' %>
                                            <% if (r.verifier_name) { %><br><span style="font-size:11px; color:#94a3b8;">By <%= r.verifier_name %></span><% } %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <%- include('partials/footer') %>
    </main>
</div>
