<%- include('partials/header', { title: 'FUTB NELFUND — Rejected Requests' }) %>

    <%- include('partials/navbar-staff', { staff, activePage: 'rejected' }) %>

    <div class="container container-xl">
        <div class="page-header">
            <div>
                <h1 class="page-heading" style="margin-bottom:4px; border-bottom:none;">Rejected Requests</h1>
                <div class="page-sub">All refund requests that have been rejected by staff</div>
            </div>
            <% if (requests.length > 0) { %>
                <a href="/staff/rejected-requests/export" class="btn-export">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Export to Excel
                </a>
            <% } %>
        </div>

        <% if (requests.length > 0) { %>
        <div class="summary-bar">
            <span class="summary-icon">&#128683;</span>
            <span class="summary-count"><%= requests.length %></span>
            <span class="summary-text">rejected refund request<%= requests.length !== 1 ? 's' : '' %> on record</span>
        </div>
        <% } %>

        <div class="card">
            <div class="card-header-flex">
                Rejected Refund Requests
                <span class="record-count"><%= requests.length %> record<%= requests.length !== 1 ? 's' : '' %></span>
            </div>

            <% if (requests.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">&#9989;</div>
                    <h3>No Rejected Requests</h3>
                    <p>There are currently no rejected refund requests in the system.</p>
                </div>
            <% } else { %>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Reg Number</th>
                            <th>Full Name</th>
                            <th>Department / Level</th>
                            <th>Payment Type</th>
                            <th>Amount (&#8358;)</th>
                            <th>Rejection Reason</th>
                            <th>Rejected By</th>
                            <th>Date Rejected</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% requests.forEach(function(r, index) { %>
                        <tr>
                            <td class="sn-col"><%= index + 1 %></td>
                            <td class="reg-col"><%= r.reg_number %></td>
                            <td class="name-col"><%= r.full_name %></td>
                            <td>
                                <div style="font-size:13px; font-weight:500;"><%= r.department %></div>
                                <div style="font-size:11.5px; color:#9ca3af; margin-top:2px;">Level <%= r.level %></div>
                            </td>
                            <td>
                                <span class="badge-payment">
                                    <% if (r.payment_type === 'first_installment') { %>1st Installment<% } else if (r.payment_type === 'second_installment') { %>2nd Installment<% } else { %>Full Payment<% } %>
                                </span>
                            </td>
                            <td style="font-weight:600; white-space:nowrap;">
                                <% if (r.refund_amount) { %>&#8358;<%= parseFloat(r.refund_amount).toLocaleString('en-NG', {minimumFractionDigits:2}) %><% } else { %><span style="color:#9ca3af;">&#8212;</span><% } %>
                            </td>
                            <td class="reason-col"><%= r.rejection_reason || '&#8212;' %></td>
                            <td>
                                <div class="rejected-by">
                                    <strong><%= r.rejected_by_name || 'N/A' %></strong>
                                    Staff
                                </div>
                            </td>
                            <td class="date-cell">
                                <% if (r.verified_at) { %><%= new Date(r.verified_at).toLocaleDateString('en-NG', {day:'2-digit', month:'short', year:'numeric'}) %><br><span style="color:#9ca3af;"><%= new Date(r.verified_at).toLocaleTimeString('en-NG', {hour:'2-digit', minute:'2-digit'}) %></span><% } else { %><span style="color:#9ca3af;">&#8212;</span><% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>
    </div>

<%- include('partials/footer') %>
