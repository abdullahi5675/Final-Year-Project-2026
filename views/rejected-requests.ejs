<%- include('partials/header', { title: 'FUTB NELFUND — Rejected Requests' }) %>

<div class="app-wrapper" id="appWrapper">
    <%- include('partials/sidebar-staff', { staff, activePage: 'rejected' }) %>

    <main class="app-main">
        <%- include('partials/topbar-staff', { staff, pageTitle: 'Rejected Requests' }) %>

        <div class="app-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
                <div>
                    <h1 class="page-heading" style="margin-bottom: 4px; border: none; padding: 0;">Rejected Refund Requests</h1>
                    <p style="color: #64748b; font-size: 14px;">Audit list of all student refund applications that have been rejected upon verification.</p>
                </div>
                <% if (requests.length > 0) { %>
                    <a href="/staff/rejected-requests/export" class="btn" style="background: #152c5b; color: white; padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 13.5px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                        Export Excel Report
                    </a>
                <% } %>
            </div>

            <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                <% if (requests.length === 0) { %>
                    <div style="text-align: center; padding: 60px 40px; color: #64748b;">
                        <div style="display:inline-flex; width:56px; height:56px; background:#f0fdf4; border-radius:50%; align-items:center; justify-content:center; margin-bottom:16px; color:#16a34a;">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <h3 style="font-size: 18px; color: #0f172a; margin-bottom: 8px; font-weight: 700;">No Rejected Requests</h3>
                        <p style="font-size: 14px; margin: 0;">There are currently no rejected refund requests in the system.</p>
                    </div>
                <% } else { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                            <thead>
                                <tr style="background: #152c5b; color: white;">
                                    <th style="padding: 14px 16px;">S/N</th>
                                    <th style="padding: 14px 16px;">Reg Number</th>
                                    <th style="padding: 14px 16px;">Full Name</th>
                                    <th style="padding: 14px 16px;">Department / Level</th>
                                    <th style="padding: 14px 16px;">Payment Type</th>
                                    <th style="padding: 14px 16px;">Amount (₦)</th>
                                    <th style="padding: 14px 16px;">Rejection Reason</th>
                                    <th style="padding: 14px 16px;">Rejected By</th>
                                    <th style="padding: 14px 16px;">Date Rejected</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% requests.forEach(function(r, index) { %>
                                    <tr style="border-bottom: 1px solid #e2e8f0; background: <%= index % 2 === 0 ? '#ffffff' : '#f8fafc' %>;">
                                        <td style="padding: 12px 16px;"><%= index + 1 %></td>
                                        <td style="padding: 12px 16px; font-weight: 600; color: #0f172a; font-family: monospace;"><%= r.reg_number %></td>
                                        <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;"><%= r.full_name %></td>
                                        <td style="padding: 12px 16px;">
                                            <div style="font-weight: 500; color: #334155;"><%= r.department %></div>
                                            <div style="font-size: 12px; color: #64748b;">Level <%= r.level %></div>
                                        </td>
                                        <td style="padding: 12px 16px;">
                                            <span style="display:inline-block; padding: 3px 8px; border-radius: 4px; font-size: 11.5px; font-weight: 600; background: #f1f5f9; color: #334155;">
                                                <%= r.payment_type.replace(/_/g, ' ') %>
                                            </span>
                                        </td>
                                        <td style="padding: 12px 16px; font-weight: 700; color: #dc2626;">
                                            ₦<%= parseFloat(r.refund_amount || 0).toLocaleString('en-NG', {minimumFractionDigits:2}) %>
                                        </td>
                                        <td style="padding: 12px 16px; color: #991b1b; max-width: 250px; line-height: 1.4;"><%= r.rejection_reason || 'N/A' %></td>
                                        <td style="padding: 12px 16px; color: #475569;"><%= r.rejected_by_name || 'N/A' %></td>
                                        <td style="padding: 12px 16px; color: #64748b; font-size: 12.5px; white-space: nowrap;">
                                            <%= r.verified_at ? new Date(r.verified_at).toLocaleDateString('en-NG', {day:'2-digit', month:'short', year:'numeric'}) : 'N/A' %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <%- include('partials/footer') %>
    </main>
</div>
