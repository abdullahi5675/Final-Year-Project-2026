<%- include('partials/header', { title: 'NELFUND — Pending Refund Requests' }) %>

    <%- include('partials/navbar-staff', { staff, activePage: 'pending' }) %>

    <div class="container">
        <h1 class="page-heading">Pending Refund Requests</h1>

        <% if (requests.length === 0) { %>
            <div class="no-requests">
                <h3>No Pending Requests</h3>
                <p>All submitted requests have been processed.</p>
            </div>
        <% } else { %>
            <% requests.forEach(function(request) { %>
                <div class="request-card">
                    <div class="request-card-header">
                        <span>Request #<%= request.request_id %> &mdash; <%= request.full_name %></span>
                        <span style="font-size:12px; font-weight:400; opacity:0.85;">
                            <%= new Date(request.submitted_at).toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'}) %>
                        </span>
                    </div>

                    <div class="request-card-body">
                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">Reg. Number</div>
                                <div class="info-value"><%= request.reg_number %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Department</div>
                                <div class="info-value"><%= request.department %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Payment Type</div>
                                <div class="info-value"><%= request.payment_type.replace(/_/g, ' ') %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Amount Paid</div>
                                <div class="info-value">₦<%= parseFloat(request.amount_paid).toLocaleString() %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Refund Amount</div>
                                <div class="info-value">₦<%= parseFloat(request.refund_amount).toLocaleString() %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Remita Number</div>
                                <div class="info-value"><%= request.remita_number %></div>
                            </div>
                        </div>

                        <hr class="divider">

                        <div class="info-grid">
                            <div class="info-item">
                                <div class="info-label">Account Name</div>
                                <div class="info-value"><%= request.account_name %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Account Number</div>
                                <div class="info-value"><%= request.account_number %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Bank</div>
                                <div class="info-value"><%= request.bank_name %></div>
                            </div>
                        </div>

                        <hr class="divider">

                        <div class="action-row">
                            <a href="/uploads/remita/<%= request.file_path.replace(/\\\\/g, '/').split('/').pop() %>"
                                target="_blank" class="btn btn-view">View Remita Document</a>

                            <form method="POST" action="/staff/verify-request/<%= request.request_id %>"
                                style="display:inline;">
                                <input type="hidden" name="action" value="approve">
                                <button type="submit" class="btn btn-approve"
                                    onclick="return confirm('Approve this refund request?')">
                                    &#10003; Approve
                                </button>
                            </form>

                            <button class="btn btn-reject"
                                onclick="showRejectModal('<%= request.request_id %>')">
                                &#10007; Reject
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <!-- Rejection Modal -->
    <div id="rejectModal" class="modal">
        <div class="modal-box">
            <div class="modal-title">
                <span>Reject Request</span>
                <span class="modal-close" onclick="closeRejectModal()">&times;</span>
            </div>
            <form id="rejectForm" method="POST" action="">
                <input type="hidden" name="action" value="reject">
                <label class="modal-label" for="rejection_reason">Reason for Rejection <span style="color:#c0392b">*</span></label>
                <textarea name="rejection_reason" id="rejection_reason" required
                    placeholder="Please provide a clear reason for rejecting this request..."></textarea>
                <button type="submit" class="btn-submit-reject">Submit Rejection</button>
            </form>
        </div>
    </div>

    <script>
        function showRejectModal(requestId) {
            const modal = document.getElementById('rejectModal');
            document.getElementById('rejectForm').action = '/staff/verify-request/' + requestId;
            modal.classList.add('active');
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').classList.remove('active');
            document.getElementById('rejection_reason').value = '';
        }

        window.addEventListener('click', function(e) {
            const modal = document.getElementById('rejectModal');
            if (e.target === modal) closeRejectModal();
        });
    </script>

<%- include('partials/footer') %>
