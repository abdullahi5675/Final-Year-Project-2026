<%- include('partials/header', { title: 'NELFUND — Staff Complaints Management' }) %>

    <%- include('partials/navbar-staff', { staff, activePage: 'complaints' }) %>

    <div class="container container-md">
        <h1 class="page-heading">Complaints Management</h1>

        <% if (complaints.length === 0) { %>
            <div class="no-requests">
                <h3>No Complaints</h3>
                <p>There are currently no complaints from students.</p>
            </div>
        <% } else { %>
            <% complaints.forEach(function(complaint) { %>
                <div class="complaint-item" style="background:#fff; padding:20px; border:1.5px solid #dbeafe; border-radius:10px; margin-bottom:16px; box-shadow:0 2px 8px rgba(21,44,91,0.06);">
                    <div class="complaint-top">
                        <div>
                            <div class="complaint-subject"><%= complaint.subject %></div>
                            <div style="font-size:12.5px; color:#666; margin-top:4px;">
                                From: <strong><%= complaint.full_name %></strong> &mdash; <%= complaint.reg_number %>
                            </div>
                        </div>
                        <span class="badge badge-<%= complaint.status %>">
                            <%= complaint.status.toUpperCase() %>
                        </span>
                    </div>

                    <p class="complaint-message"><%= complaint.message %></p>
                    <div class="complaint-date">
                        Submitted: <%= new Date(complaint.created_at).toLocaleString() %>
                    </div>

                    <% if (complaint.status === 'answered') { %>
                        <div class="reply-box">
                            <div class="reply-label">Your Reply</div>
                            <%= complaint.reply %>
                            <div class="reply-date">
                                Replied: <%= new Date(complaint.replied_at).toLocaleString() %>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/staff/complaints/<%= complaint.complaint_id %>" class="btn btn-primary" style="margin-top:12px; display:inline-block;">
                            Reply to Complaint
                        </a>
                    <% } %>
                </div>
            <% }); %>
        <% } %>
    </div>

<%- include('partials/footer') %>