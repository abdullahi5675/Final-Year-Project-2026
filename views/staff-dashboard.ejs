<%- include('partials/header', { title: 'NELFUND — Dashboard' }) %>

<div class="app-wrapper" id="appWrapper">
    <%- include('partials/sidebar-staff', { staff, activePage: 'dashboard' }) %>

    <main class="app-main">
        <%- include('partials/topbar-staff', { staff, pageTitle: 'Portal Dashboard' }) %>

        <div class="app-content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <div>
                    <h1 class="page-heading" style="margin-bottom: 4px; border: none; padding: 0;">
                        <%= staff.role === 'admin' ? 'Administrator Dashboard' : 'Staff Dashboard' %>
                    </h1>
                    <p style="color: #64748b; font-size: 14px;">
                        Welcome back, <%= staff.full_name %>! Live overview of NELFUND uploads, refund verification statuses, and Bursary schedules.
                    </p>
                </div>
            </div>

            <!-- Stat Cards Overview -->
            <div class="section-title" style="font-size: 13px; font-weight: 700; color: #475569; margin-bottom: 16px; margin-top:0;">Key Performance Indicators</div>
            
            <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px;">
                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #f59e0b; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #d97706;"><%= stats.pending %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Pending Verification</div>
                </div>

                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #10b981; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #059669;"><%= stats.approved %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Approved (Unbatched)</div>
                </div>

                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #3b82f6; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #2563eb;"><%= stats.exported %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Exported to Bursary</div>
                </div>

                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #152c5b; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #152c5b;"><%= stats.totalApproved %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Total Approved Requests</div>
                </div>

                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #ef4444; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #dc2626;"><%= stats.rejected %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Rejected Requests</div>
                </div>

                <div class="stat-card" style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #8b5cf6; border-radius: 10px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                    <div class="stat-number" style="font-size: 30px; font-weight: 800; color: #7c3aed;"><%= stats.totalStudents %></div>
                    <div class="stat-label" style="font-size: 13px; font-weight: 600; color: #64748b; margin-top: 4px;">Uploaded Students</div>
                </div>
            </div>

            <!-- Executive Quick Summary Panel -->
            <div style="background: white; border-radius: 12px; border: 1px solid #e2e8f0; padding: 28px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0;">Portal Management Console</h3>
                    <span style="font-size: 12.5px; color: #64748b; font-weight: 500;">Role: <%= staff.role.toUpperCase() %></span>
                </div>
                <p style="color: #475569; font-size: 14px; line-height: 1.6; margin-bottom: 20px;">
                    Use the sidebar navigation menu on the left to upload NELFUND list files, review pending refund applications, export Bursary schedules, respond to student complaints, and manage administrative settings.
                </p>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <a href="/staff/pending-requests" class="btn" style="background: #152c5b; color: white; padding: 10px 20px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Review Pending Requests (<%= stats.pending %>)
                    </a>
                    <a href="/staff/upload-list" class="btn" style="background: #2563eb; color: white; padding: 10px 20px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                        Upload NELFUND File
                    </a>
                    <a href="/staff/generate-batch" class="btn" style="background: #059669; color: white; padding: 10px 20px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                        Generate Bursary Schedule
                    </a>
                </div>
            </div>
        </div>

        <%- include('partials/footer') %>
    </main>
</div>