<%- include('partials/header', { title: 'NELFUND — Student Dashboard' }) %>

    <%- include('partials/navbar-student', { student, activePage: 'dashboard' }) %>

    <div class="container container-md">
        <h1 class="page-heading">Student Dashboard</h1>

        <!-- Student Info -->
        <div class="card-padded">
            <div class="card-header" style="margin: -24px -24px 20px; border-radius: 10px 10px 0 0;">Your Information</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Registration Number</div>
                    <div class="info-value"><%= student.reg_number %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Full Name</div>
                    <div class="info-value"><%= student.full_name %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Department</div>
                    <div class="info-value"><%= student.department %></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Level</div>
                    <div class="info-value"><%= student.level %></div>
                </div>
            </div>
        </div>

        <!-- Refund Status -->
        <div class="card-padded">
            <div class="card-header" style="margin: -24px -24px 20px; border-radius: 10px 10px 0 0;">Refund Status</div>

            <% if (existingRequest) { %>
                <div class="info-grid" style="margin-bottom: 16px;">
                    <div class="info-item">
                        <div class="info-label">Status</div>
                        <div class="info-value" style="margin-top:4px;">
                            <span class="badge badge-<%= existingRequest.status %>">
                                <%= existingRequest.status.toUpperCase() %>
                            </span>
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date Submitted</div>
                        <div class="info-value"><%= new Date(existingRequest.submitted_at).toLocaleString() %></div>
                    </div>
                    <% if (existingRequest.refund_amount) { %>
                    <div class="info-item">
                        <div class="info-label">Refund Amount</div>
                        <div class="amount-display">₦<%= parseFloat(existingRequest.refund_amount).toLocaleString() %></div>
                    </div>
                    <% } %>
                </div>

                <% if (existingRequest.status === 'pending') { %>
                    <div class="alert alert-info">
                        <strong>&#10003; Request Submitted</strong><br>
                        Your refund request is currently under review. You will be notified once a decision is made.
                    </div>
                <% } %>

                <% if (existingRequest.status === 'approved') { %>
                    <div class="alert alert-success">
                        <strong>&#10003; Request Approved</strong><br>
                        Your refund has been approved and will be processed by the Bursary Department.
                    </div>
                <% } %>

                <% if (existingRequest.status === 'rejected') { %>
                    <div class="alert alert-danger">
                        <strong>Request Rejected</strong><br>
                        <strong>Reason:</strong> <%= existingRequest.rejection_reason %>
                    </div>
                <% } %>

            <% } else { %>
                <div class="alert alert-warning">
                    <strong>No Request on File</strong><br>
                    You have not yet submitted a refund request.
                </div>
            <% } %>
        </div>

        <!-- CTA -->
        <% if (!existingRequest) { %>
        <div class="card-padded">
            <div class="card-header" style="margin: -24px -24px 20px; border-radius: 10px 10px 0 0;">Apply for NELFUND Refund</div>
            <div class="cta-section">
                <p>
                    Did you pay your school fees before NELFUND disbursed your loan?<br>
                    If yes, you are eligible to apply for a refund.
                </p>
                <div class="cta-actions">
                    <a href="/student/refund-request" class="btn btn-primary">Yes — Apply for Refund</a>
                    <button class="btn btn-secondary"
                        onclick="alert('You are not eligible for a refund because you did not pay before NELFUND disbursed your loan.')">
                        No, I Did Not Pay
                    </button>
                </div>
            </div>
        </div>
        <% } %>
    </div>

<%- include('partials/footer') %>