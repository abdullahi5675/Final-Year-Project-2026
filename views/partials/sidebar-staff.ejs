<!-- Staff / Admin Vertical Sidebar -->
<aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo-badge">
            <img src="/FUTBBBBBBB.png" alt="FUTB Logo">
        </div>
        <div>
            <div class="sidebar-brand-title">NELFUND Portal</div>
            <div class="sidebar-brand-sub">FUT Babura</div>
        </div>
    </div>

    <div class="sidebar-body">
        <!-- Main Navigation -->
        <div class="nav-section-label">Main Menu</div>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/staff/dashboard" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'dashboard') { %> active<% } %>" title="Dashboard">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/upload-list" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'upload') { %> active<% } %>" title="Upload NELFUND List">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" /></svg>
                    <span class="sidebar-link-text">Upload NELFUND List</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/pending-requests" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'pending') { %> active<% } %>" title="Pending Requests">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="sidebar-link-text">Pending Requests</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/approved-requests" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'approved') { %> active<% } %>" title="Approved Requests Directory">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="sidebar-link-text">Approved Requests</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/generate-batch" class="sidebar-link" title="Export Bursary Schedule">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m.75 12l3 3m0 0l3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                    <span class="sidebar-link-text">Export Bursary Schedule</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/rejected-requests" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'rejected') { %> active<% } %>" title="Rejected Requests">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="sidebar-link-text">Rejected Requests</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/complaints" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'complaints') { %> active<% } %>" title="Student Complaints">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
                    <span class="sidebar-link-text">Student Complaints</span>
                </a>
            </li>
        </ul>

        <% if (staff.role === 'admin') { %>
            <!-- Administration Section -->
            <div class="nav-section-label">Administration</div>
            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a href="/staff/register" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'register-staff') { %> active<% } %>" title="Register Staff">
                        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" /></svg>
                        <span class="sidebar-link-text">Register Staff</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="/staff/manage" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'manage-staff') { %> active<% } %>" title="Staff Directory">
                        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766v-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                        <span class="sidebar-link-text">Staff Directory</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a href="/staff/activity-logs" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'activity-logs') { %> active<% } %>" title="System Activity Logs">
                        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>
                        <span class="sidebar-link-text">System Activity Logs</span>
                    </a>
                </li>
            </ul>
        <% } %>

        <!-- User Settings -->
        <div class="nav-section-label">Account</div>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/staff/profile" class="sidebar-link<% if (typeof activePage !== 'undefined' && activePage === 'profile') { %> active<% } %>" title="My Profile">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                    <span class="sidebar-link-text">My Profile</span>
                </a>
            </li>
            <li class="sidebar-item">
                <a href="/staff/logout" class="sidebar-link" style="color: #f87171;" title="Sign Out">
                    <svg viewBox="0 0 24 24" style="stroke: #f87171;"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" /></svg>
                    <span class="sidebar-link-text">Sign Out</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="sidebar-footer">
        <div>NELFUND Portal v2.0</div>
        <div>FUT Babura &copy; <%= new Date().getFullYear() %></div>
    </div>
</aside>

<!-- Backdrop overlay for mobile sidebar drawer -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>
