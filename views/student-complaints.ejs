<%- include('partials/header', { title: 'NELFUND — My Complaints' }) %>

    <%- include('partials/navbar-student', { student, activePage: 'complaints' }) %>

    <div class="container container-md">
        <a href="/student/dashboard" class="btn-back">&larr; Back to Dashboard</a>
        <h1 class="page-heading">My Complaints</h1>

        <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

        <!-- Submit Form -->
        <div class="card">
            <div class="card-header">Submit a New Complaint</div>
            <div class="card-body">
                <form action="/student/complaints" method="POST">
                    <div class="form-group">
                        <label for="subject">Subject <span style="color:#c0392b">*</span></label>
                        <input type="text" id="subject" name="subject" required
                            placeholder="Brief description of the issue">
                    </div>
                    <div class="form-group">
                        <label for="message">Message <span style="color:#c0392b">*</span></label>
                        <textarea id="message" name="message" rows="4" required
                            placeholder="Describe your complaint in detail..."></textarea>
                    </div>
                    <button type="submit" class="btn-submit">Submit Complaint</button>
                </form>
            </div>
        </div>

        <!-- Complaint History -->
        <div class="card">
            <div class="card-header">Complaint History</div>
            <div class="card-body">
                <% if (complaints.length === 0) { %>
                    <div class="empty-note">You have not submitted any complaints yet.</div>
                <% } else { %>
                    <% complaints.forEach(function(complaint) { %>
                        <div class="complaint-item">
                            <div class="complaint-top">
                                <div class="complaint-subject"><%= complaint.subject %></div>
                                <span class="badge badge-<%= complaint.status %>">
                                    <%= complaint.status.toUpperCase() %>
                                </span>
                            </div>
                            <p class="complaint-message"><%= complaint.message %></p>
                            <div class="complaint-date">
                                Submitted: <%= new Date(complaint.created_at).toLocaleString() %>
                            </div>

                            <% if (complaint.status === 'answered') { %>
                                <div class="reply-box">
                                    <div class="reply-label">Staff Reply</div>
                                    <%= complaint.reply %>
                                    <div class="reply-date">
                                        Replied: <%= new Date(complaint.replied_at).toLocaleString() %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>
