<%- include('partials/header', { title: 'NELFUND Staff Portal — Staff Login', bodyClass: 'login-body' }) %>

<style>
    body.login-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 30px 20px;
    }
</style>

    <!-- Dual Logo Header -->
    <div class="logo-header">
        <img src="/FUTBBBBBBB.png" alt="FUTB Logo">
        <div class="logo-header-text">
            <div class="institution">Federal University of Technology, Babura</div>
            <div class="portal-name">NELFUND Staff Portal</div>
        </div>
        <img src="/Nelfund .webp" alt="NELFUND Logo">
    </div>

    <!-- Login Card -->
    <div class="login-card">
        <div class="card-title">Staff Login</div>
        <div class="card-subtitle">Authorized personnel only — enter your credentials to proceed</div>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form method="POST" action="/staff/login">
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required
                    placeholder="Enter your username" autofocus>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required
                    placeholder="Enter your password">
            </div>
            <button type="submit" class="btn-submit">Login &rarr;</button>
        </form>

        <div class="footer-note">
            For authorized NELFUND/Bursary staff only.
        </div>
        <div class="student-link">
            <a href="/">&larr; Student Login</a>
        </div>
    </div>

<%- include('partials/footer') %>
