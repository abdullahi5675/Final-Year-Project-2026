<%- include('partials/header', { title: 'NELFUND — Staff & Admin Login', bodyClass: 'login-body' }) %>

<style>
    body.login-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 30px 20px;
    }
</style>

<!-- Dual Logo Header -->
<div class="logo-header">
    <img src="/FUTBBBBBBB.png" alt="FUTB Logo">
    <div class="logo-header-text">
        <div class="institution">Federal University of Technology, Babura</div>
        <div class="portal-name">NELFUND Staff & Admin Portal</div>
    </div>
    <img src="/Nelfund .webp" alt="NELFUND Logo">
</div>

<!-- Login Card -->
<div class="login-card">
    <div class="card-title">Staff & Admin Login</div>
    <div class="card-subtitle">Enter your registered email address and password to access the portal</div>

    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/staff/login">
        <div class="form-group">
            <label for="email">Email Address</label>
            <input type="text" id="email" name="email" required placeholder="e.g. staff@nelfund.edu or username" autofocus>
        </div>
        <div class="form-group">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label for="password" style="margin-bottom: 0;">Password</label>
                <a href="javascript:void(0)" onclick="openForgotModal()" style="font-size: 12px; color: #2563eb; text-decoration: none; font-weight: 600;">Forgot Password?</a>
            </div>
            <div class="password-input-wrapper">
                <input type="password" id="password" name="password" required placeholder="Enter your password">
                <button type="button" class="btn-eye-toggle" onclick="togglePasswordVisibility('password', this)" aria-label="Toggle password visibility">
                    <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </button>
            </div>
        </div>
        <button type="submit" class="btn-submit">Login to Portal &rarr;</button>
    </form>

    <div class="footer-note">
        Authorized NELFUND & Bursary administration only.
    </div>
    <div class="student-link" style="display: flex; justify-content: space-between; margin-top: 16px; font-size: 13px;">
        <a href="/">&larr; Portal Home Page</a>
        <a href="/student/login">Student Login &rarr;</a>
    </div>
</div>

<!-- Forgot Password Modal -->
<div id="forgotModal" class="modal">
    <div class="modal-box">
        <div class="modal-title">
            <span>Staff Password Recovery</span>
            <span class="modal-close" onclick="closeForgotModal()">&times;</span>
        </div>
        <form id="forgotForm" onsubmit="handleForgotSubmit(event)">
            <p style="font-size: 13.5px; color: #475569; margin-bottom: 16px; line-height: 1.5;">
                Enter your registered staff email address below to submit a password reset notification to the System Administrator.
            </p>
            <div id="forgotAlert" style="display:none; padding:10px; border-radius:6px; font-size:13px; margin-bottom:14px;"></div>
            <div class="form-group" style="margin-bottom: 20px;">
                <label class="modal-label" for="forgot_identity">Email Address</label>
                <input type="email" id="forgot_identity" required placeholder="e.g. staff@nelfund.edu" style="width: 100%; padding: 10px 14px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 14px;">
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 14px; font-weight: 700; background: #152c5b; color: white; border: none; border-radius: 8px; cursor: pointer;">
                Submit Reset Request
            </button>
        </form>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        if (input.type === 'password') {
            input.type = 'text';
            btn.innerHTML = `<svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>`;
        } else {
            input.type = 'password';
            btn.innerHTML = `<svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`;
        }
    }

    function openForgotModal() {
        document.getElementById('forgotModal').classList.add('active');
        document.getElementById('forgotAlert').style.display = 'none';
    }
    function closeForgotModal() {
        document.getElementById('forgotModal').classList.remove('active');
        document.getElementById('forgot_identity').value = '';
    }
    async function handleForgotSubmit(e) {
        e.preventDefault();
        const identity = document.getElementById('forgot_identity').value;
        const alertBox = document.getElementById('forgotAlert');

        try {
            const res = await fetch('/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ identity, account_type: 'staff' })
            });
            const data = await res.json();
            alertBox.style.display = 'block';
            alertBox.style.background = '#f0fdf4';
            alertBox.style.color = '#166534';
            alertBox.style.border = '1px solid #bbf7d0';
            alertBox.innerText = data.message;
        } catch (err) {
            alertBox.style.display = 'block';
            alertBox.style.background = '#fef2f2';
            alertBox.style.color = '#991b1b';
            alertBox.style.border = '1px solid #fecaca';
            alertBox.innerText = 'Network error. Please try again.';
        }
    }
</script>

<%- include('partials/footer') %>
